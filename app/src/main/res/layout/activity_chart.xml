<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/cryptoInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="BTCUSDT"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:inputType="textCapCharacters"
            android:backgroundTint="#4CAF50"/>

        <Spinner
            android:id="@+id/timeframeSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:backgroundTint="#4CAF50"/>
    </LinearLayout>

    <Button
        android:id="@+id/getChartButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Загрузить график"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"/>

    <com.example.tradeview.CandleStickChartView
        android:id="@+id/candleStickChartView"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="16dp"/>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <Button
        android:id="@+id/predictButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Спрогнозировать"
        android:enabled="false"
        android:backgroundTint="#FF9800"
        android:textColor="#FFFFFF"/>

    <TextView
        android:id="@+id/predictionResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="16sp"
        android:lineSpacingMultiplier="1.2"
        android:textColor="#FFFFFF"
        android:padding="8dp"
        android:background="#1E1E1E"/>
    <Button
        android:id="@+id/btnUpdateLevels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Обновить уровни"
        android:layout_marginTop="8dp"
        android:backgroundTint="#3F51B5"
        android:textColor="#FFFFFF"/>
</LinearLayout>